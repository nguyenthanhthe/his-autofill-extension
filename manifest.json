{
  "manifest_version": 3,
  "name": "HIS V20 - Khám Sức Khỏe",
  "version": "1.1.0",
  "description": "Tự động điền nhanh hồ sơ tiếp đón và kết quả 7 chuyên khoa khám sức khỏe định kỳ trên hệ thống HIS V20",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HIS V20 - Khám Sức Khỏe",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://v20.ytecoso.vn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://v20.ytecoso.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
