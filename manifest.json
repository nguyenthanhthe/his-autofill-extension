{
  "manifest_version": 3,
  "name": "HIS V2 - Tự Động Điền Giấy Khám Sức Khỏe",
  "version": "1.0.0",
  "description": "Tiện ích hỗ trợ cán bộ y tế điền nhanh thông tin thể lực, chuyên khoa lâm sàng và kết luận khám sức khỏe trên HIS V2",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HIS V2 Khám Sức Khỏe",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://v20.ytecoso.vn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://v20.ytecoso.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
